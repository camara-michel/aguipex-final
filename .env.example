# Copier vers .env et renseigner les valeurs (ne pas commiter .env)
# cp .env.example .env

# Django
SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,export.gdb.gn,www.export.gdb.gn
CSRF_TRUSTED_ORIGINS=https://export.gdb.gn,https://www.export.gdb.gn

# Base de données MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=aguipex_gestiondb
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=3306

# Fichiers média
MEDIA_URL=/media/

# E-mail (Mailgun / Anymail)
MAILGUN_SECRET_KEY=
MAILGUN_SENDER_DOMAIN=
FROM_EMAIL=
MAILERSEND_API_TOKEN=
